# App
APP_URL=http://localhost:3377
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Database (PostGIS)
DATABASE_URL=postgresql://flightbuddy:flightbuddy@localhost:5432/flightbuddy?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# OpenSky Network OAuth2 client (optional but recommended — higher rate limits)
# Account → API client: https://opensky-network.org/my-opensky/account
# USERNAME = client_id (often ends in -api-client), PASSWORD = client_secret
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AeroDataBox via API.Market (optional — gates, delays, official status)
# Subscribe: https://api.market/store/aedbx/aerodatabox  (or https://apimarket.aerodatabox.com)
# Docs: https://doc.aerodatabox.com/  → “Via API.Market”
# Copy the API.Market key into AERODATABOX_KEY. Auth header is x-api-market-key.
# Do NOT use RapidAPI host aerodatabox.p.rapidapi.com — that host rejects API.Market keys
# (403 “not subscribed” or leftover RapidAPI 429 BASIC).
AERODATABOX_KEY=
AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
# Optional RapidAPI fallback only if you still subscribe there:
# AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# Web Push — keys are generated automatically and stored in AppSetting.
# Optional override if you already have a pair:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:flightbuddy@localhost

# Polling
OPENSKY_MIN_INTERVAL_MS=90000
PREFLIGHT_WINDOW_HOURS=2

# FlightRadar24 official API (Explorer). Token from Key management:
# https://fr24api.flightradar24.com/docs/authentication
# Official SDK env name. Auth: Authorization: Bearer <token>
# Live position: GET /api/live/flight-positions/light (6 credits per returned flight).
# Explorer: ~10 requests/min, 30k credits/month. Never scrape flightradar24.com.
FR24_API_TOKEN=
# Optional kill switch without removing the token (default on). Settings UI can also pause.
# FR24_ENABLED=true
# Optional per-flight FR24 interval (default 180000 = 3 min, cruise-like; never 10s climb-out).
# FR24_MIN_INTERVAL_MS=180000
