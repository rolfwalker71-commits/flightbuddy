# --- Zugriff der App auf den Server ---
# Zufälliger Wert: openssl rand -hex 24. Derselbe Wert kommt in die App-Einstellungen.
API_TOKEN=

PORT=8787

# --- airplanes.live (einzige Live-Datenquelle) ---
AIRPLANES_BASE_URL=https://api.airplanes.live/v2
AIRPLANES_CONTACT=rolf@rolfwalker.ch

# --- APNs: Schlüssel gilt für das ganze Team und alle Apps ---
APNS_KEY_ID=                  # aus dem Dateinamen AuthKey_<KEYID>.p8
APNS_TEAM_ID=9XZWUZ7Z26
APNS_TOPIC=ch.rolfwalker.flightbuddy
# Pfad der .p8-Datei auf dem Server (nur für Docker Compose)
APNS_KEY_HOST_PATH=

# --- Abfrage-Takt in Sekunden ---
POLL_ACTIVE_SECONDS=15
POLL_IDLE_SECONDS=60
